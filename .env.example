# Public HTTPS address of this server, used in upload and download links.
PD_PUBLIC_URL=http://localhost:8787

# 32+ random characters, used to sign upload and download links.
PD_SECRET=

# One entry per friend: token:userId:Name, separated by commas. Create entries with: npm run new-friend -- <userId> "<Name>"
PD_USERS=

# Where cases and images are stored (file store).
PD_DATA_DIR=.data

# Set to 0 to skip loading Google Fonts when rendering (offline).
PD_WEB_FONTS=1

PORT=8787
