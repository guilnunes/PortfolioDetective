    {
      "id": "results",
      "kind": "section",
      "purpose": "Results",
      "html": "<section class=\"s\"><h2>Results</h2><div class=\"b\"><p>Within the first month, orders moved from DMs to the page. Live since mid 2025.</p></div></section>",
      "css": ".s{padding:140px 120px;display:grid;grid-template-columns:360px 1fr;gap:80px}\nh2{font:600 44px/1.1 var(--pd-font-heading);color:var(--pd-accent)}\n.b p{font:400 28px/1.55 var(--pd-font-body);margin-bottom:28px;max-width:820px}",
